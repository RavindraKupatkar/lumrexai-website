{
  "version": 2,
  "outputDirectory": ".",
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/og-image.png", "dest": "/og-image.png" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/favicon.png", "dest": "/favicon.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
